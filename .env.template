# Environment Variables Template — copy to .env and fill in your values
# NEVER commit the actual .env file to version control

# Standard SMTP settings (Works with Mailtrap, Gmail, etc.)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username_here
SMTP_PASS=your_mailtrap_password_here

# Sender and recipient email addresses
ALERT_FROM_EMAIL=alerts@yourcompany.com
ALERT_TO_EMAIL=manager@yourcompany.com

# Gemini API Key for model reasoning and email body generation
GEMINI_API_KEY=your_gemini_api_key_here

# Slack Webhook URL for #pricing-alerts channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Reference price threshold (percentage below which an alert is fired)
PRICE_ALERT_THRESHOLD=0.10
